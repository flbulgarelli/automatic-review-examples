PORT=3000

# Reviewer implementation: llm | detoxify | approve_all
# - llm: usa un LLM (configurable abajo) para clasificar + explicar
# - detoxify: clasifica toxicidad con un modelo local (toxic-bert, inglés)
# - approve_all: aprueba siempre (útil para dev / demos sin modelos)
REVIEWER_IMPL=llm

# LLM provider: ollama | openai | openai-compatible | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://localhost:11434/api

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Ejemplo vLLM (OpenAI-compatible) ---
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# OPENAI_API_KEY=dummy   # vLLM acepta cualquier valor por default
